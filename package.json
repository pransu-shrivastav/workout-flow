{
  "name": "workout-flow",
  "version": "2.0.0",
  "description": "Guided personal workout tracker — offline-first PWA",
  "private": true,
  "type": "module",
  "scripts": {
    "test":      "vitest run",
    "test:watch":"vitest",
    "test:e2e":  "playwright test",
    "test:all":  "vitest run && playwright test",
    "serve":     "npx serve . -p 3000",
    "dev":       "node serve.js"
  },
  "devDependencies": {
    "vitest":              "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0",
    "@playwright/test":    "^1.44.0",
    "serve":               "^14.2.3"
  }
}